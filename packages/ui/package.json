    "format:fix": "oxfmt .",
    "format:check": "oxfmt --check .",
    "clean": "rm -rf node_modules/.cache"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.7",
