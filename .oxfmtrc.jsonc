{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "avoid",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "jsxSingleQuote": false,
  "printWidth": 120,
  "proseWrap": "preserve",
  "quoteProps": "as-needed",
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "es5",
  // Import order: 1) external, 2) @meoru/*, 3) @/ internal, 4) relative, 5) CSS/styles
  "sortImports": {
    "internalPattern": ["@/"],
    "customGroups": [
      { "groupName": "monorepo-style", "elementNamePattern": ["@meoru/**/*.css", "@meoru/**/*.scss"] },
      { "groupName": "monorepo", "elementNamePattern": ["@meoru/**"] },
    ],
    "groups": [
      ["external", "builtin", "type-external", "type-builtin", "wildcard-external", "default-external"],
      "monorepo",
      ["internal", "type-internal"],
      ["parent", "sibling", "index", "type-parent", "type-sibling", "type-index"],
      ["style", "side_effect_style", "monorepo-style"],
      "side_effect",
      "type-import",
      "unknown",
    ],
  },
  // Tailwind v4 + shadcn/ui class sorting. `stylesheet` points at the shared theme so custom
  // utilities (bg-background, border-border, ...) sort as known classes instead of trailing unknowns.
  "sortTailwindcss": {
    "stylesheet": "./packages/ui/src/styles/globals.css",
    "functions": ["cn", "cva"],
  },
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    ".github/**",
    ".vscode/**",
    "**/.turbo/**",
    "**/.next/**",
    "**/dist/**",
    "**/out/**",
    "**/build/**",
    "**/coverage/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "**/next-env.d.ts",
    "pnpm-lock.yaml",
  ],
}
