{
  "extends": "@meoru/typescript-config/nextjs.json",
  "compilerOptions": {
    // Build-time modules in `lib/` are also loaded by Node scripts, which need explicit extensions.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./*"],
      "@meoru/ui/*": ["../../packages/ui/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "next.config.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
